// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   // WhatsApp-enabled number (opt-in, E.164) for follow-up reminders
  image         String?
  password      String?   // For email/password authentication
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts        Account[]
  sessions        Session[]
  testSessions    TestSession[]
  predictionLogs  PredictionLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TestSession {
  id              String   @id @default(cuid())
  userId          String?
  personName      String   @default("Myself")
  isSelf          Boolean  @default(true)
  relation        String?  // e.g. Parent, Child, Spouse, Sibling, Friend, Other
  gender          String?  // e.g. Male, Female, Other, Prefer not to say
  language        String   @default("en")
  answers         String   // JSON string of Answer[]
  score           Int?
  urgency         String?
  factors         String?  // JSON string of Factor[]
  primaryCategory String?
  recommendation  String?
  confidenceScore      Float?
  confidenceLevel      String?
  confidenceExplanation String?
  riskReasoning        String?
  riskSummary          String?  // Groq narrative for "Why this risk level?"
  riskFactors          String?  // JSON string of string[] — bullet factors
  primaryAction        String?  // Groq primary action line
  recommendationSteps  String?  // JSON string of string[] — action steps
  keyInsights          String?  // JSON string of string[]
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id])
  predictionLogs  PredictionLog[]
  followUps       FollowUp[]
}

// Machine-learning inference log — one row per real /api/ml/predict call.
// Stores ONLY the numeric feature vector + prediction result, no free text,
// so anonymous (guest) triages can feed the retraining loop without PII.
model PredictionLog {
  id                  String       @id @default(cuid())
  testSessionId       String?
  userId              String?
  features            String       // JSON of the full ML feature vector sent
  ruleScore           Float?       // rule-engine score received by the model
  predictedConfidence Float?       // model output (0–1), null when ML unavailable
  confidenceLevel     String?      // High | Medium | Low | unavailable
  mlAvailable         Boolean      @default(true)
  modelVersion        String?
  latencyMs           Int?
  createdAt           DateTime     @default(now())
  testSession         TestSession? @relation(fields: [testSessionId], references: [id], onDelete: SetNull)
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([testSessionId])
  @@index([createdAt])
}

// Scheduled outcome check-in for a completed assessment — the ground-truth
// labels that make continuous retraining meaningful.
model FollowUp {
  id              String      @id @default(cuid())
  testSessionId   String
  status          String      @default("pending") // pending | responded | dismissed
  scheduledAt     DateTime    // earliest time the user is prompted
  respondedAt     DateTime?
  contactedDoctor Boolean?    // did they reach a doctor/emergency line
  diagnosis       String?     // reported diagnosis (free text)
  resolved        String?     // yes | no | partial
  improved        String?     // worse | same | better | recovered
  notes           String?
  lastRemindedAt  DateTime?   // last reminder sent (drives daily rate limiting)
  reminderCount   Int         @default(0) // reminders sent so far (cap = 3)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  testSession     TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)

  @@index([testSessionId])
  @@index([status])
}
