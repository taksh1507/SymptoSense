# Copy to .env (Prisma CLI, Next.js and Python read the same local configuration).
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GROQ_API_KEY=""
SARVAM_API_KEY=""
ML_SERVICE_URL="http://127.0.0.1:8000"
# Optional legacy full prediction URL; leave blank when using ML_SERVICE_URL.
# ML_SERVER_URL="http://127.0.0.1:8000/predict-confidence"
ADMIN_EMAILS=""
RETRAIN_TOKEN=""
# Required for production: Redis REST pipeline endpoint and bearer token.
RATE_LIMIT_REST_URL=""
RATE_LIMIT_REST_TOKEN=""
TRUST_PROXY="false"
# Reminders require both configured channels and explicit account opt-in.
SCHEDULER_DISABLED="1"
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="symptosense_followup"

# Calibrated top disease probability below this value is uncertain.
DISEASE_CONFIDENCE_THRESHOLD=0.5
