# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# python
__pycache__/
*.pyc
ml-service/*.bak
ml-service/retrain_report.json

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local databases, backups, virtualenvs, and generated checks
*.db
*.db-journal
*.db-wal
*.db-shm
.local/
.venv/
api/confidence_model.joblib
!.env.example

.pytest_cache/
ml-service/data/source.zip
ml-service/data/ddxplus/*
!ml-service/data/ddxplus/SOURCE.md
# Small CC BY 4.0 schema files required at inference time (not the patient data):
!ml-service/data/ddxplus/release_evidences.json
!ml-service/data/ddxplus/release_conditions.json
!ml-service/data/ddxplus/CC-BY-4.0.txt
